# Copy this file to ".env.local" and fill in your values.
# Get these after deploying the Apps Script Web App (see apps-script/DEPLOY.md).

# The Apps Script Web App URL (ends with /exec)
MAC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# The shared token you set in Code.gs CONFIG.TOKEN
MAC_API_TOKEN=your-long-random-token

# ---- Auth (email + password login via NextAuth v5) ----
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
# In production set your canonical URL, e.g. https://mac.internal
# AUTH_URL=http://localhost:3000
